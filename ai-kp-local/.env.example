AI_KP_DB_PATH=data/ai_kp.sqlite3
AI_KP_LLM_BASE_URL=http://localhost:11434/v1
AI_KP_LLM_API_KEY=local
AI_KP_LLM_MODEL=qwen3:8b
AI_KP_CORS_ORIGINS=http://localhost:5173

# 仅限真正的单机开发环境。设为 true 时，来自回环地址的请求可执行
# 创建团/开启会话等初始化操作，无需管理员口令。
AI_KP_LOCAL_ADMIN_ENABLED=true

# LAN、反向代理或任何非单机部署必须：
# 1. 将 AI_KP_LOCAL_ADMIN_ENABLED 设为 false；
# 2. 改成一个长且随机的管理员口令；
# 3. 只通过 HTTPS 访问，并让前端用 X-AI-KP-Admin-Token 发送该口令。
# 单机示例默认留空；切换到 LAN/反向代理配置时必须填入长随机值。
AI_KP_ADMIN_TOKEN=
