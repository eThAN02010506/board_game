AI_KP_DB_PATH=data/ai_kp.sqlite3
AI_KP_LLM_BASE_URL=http://localhost:11434/v1
AI_KP_LLM_API_KEY=local
AI_KP_LLM_MODEL=qwen3:8b
AI_KP_CORS_ORIGINS=http://localhost:5173

# 可选的独立图片模型。必须提供 OpenAI-compatible /v1/images/generations，
# 并返回 b64_json。未配置时结构地图和精美 SVG 回退仍可完整游玩。
AI_KP_IMAGE_BASE_URL=
AI_KP_IMAGE_API_KEY=local
AI_KP_IMAGE_MODEL=
AI_KP_MAP_ASSET_ROOT=data/map-assets
AI_KP_MODULE_ASSET_ROOT=data/module-assets
AI_KP_RULEBOOK_INDEX_ROOT=data/rag/rulesets
AI_KP_BACKUP_ROOT=data/backups

# 仅限真正的单机开发环境。设为 true 时，来自回环地址的请求可执行
# 创建团/开启会话等初始化操作，无需管理员口令。
AI_KP_LOCAL_ADMIN_ENABLED=true

# LAN、反向代理或任何非单机部署必须：
# 1. 将 AI_KP_LOCAL_ADMIN_ENABLED 设为 false；
# 2. 改成一个长且随机的管理员口令；
# 3. 只通过 HTTPS 访问，并让前端用 X-AI-KP-Admin-Token 发送该口令。
# 单机示例默认留空；切换到 LAN/反向代理配置时必须填入长随机值。
AI_KP_ADMIN_TOKEN=

# 显式设为 lan 后才启用 Host allowlist 与敏感操作滑动窗口限流，并强制要求
# AI_KP_ADMIN_TOKEN。域名或局域网 IP 必须逐项加入 trusted hosts。
AI_KP_DEPLOYMENT_MODE=local
AI_KP_TRUSTED_HOSTS=localhost,127.0.0.1
AI_KP_SENSITIVE_RATE_LIMIT_REQUESTS=20
AI_KP_SENSITIVE_RATE_LIMIT_WINDOW_SECONDS=60
